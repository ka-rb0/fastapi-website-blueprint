# Copy this file to .devcontainer/.env and adjust the values for your machine.
LOG_LEVEL="INFO"
LOG_FORMAT="text"
DATA_PATH="/mnt/data"
CLAUDE_HOME_HOST_PATH="<your_claude_home_host_path>"
CODEX_HOME_HOST_PATH="<your_codex_home_host_path>"
# A classic token wants the repo, read:org, workflow and gist scopes. It is
# gh's alone: git keeps authenticating through the host, so this may even be
# another account. Leave it commented out to use `gh auth login` instead.
# GH_TOKEN_FWB="<your_github_cli_token>"
# The dev server is only reachable from this machine by default. Uncomment to
# expose it to your LAN (e.g. to test from a phone on the same network):
# WEBSITE_BIND_HOST="0.0.0.0"
# The app answers only requests whose Host header it trusts
# (Settings.trusted_hosts in src/app/config.py); anything else gets a 400.
# When testing from a phone,
# uncomment and append the address the phone uses to reach this machine:
# WEBSITE_TRUSTED_HOSTS="localhost,127.0.0.1,proxy.localhost,192.168.0.5"
# Interactive API docs at /docs - on by default in the dev container.
# Uncomment to turn them off:
# WEBSITE_ENABLE_DOCS=0
WEBSITE_EXTERNAL_PORT=11110
UVICORN_PORT=11111
# The inclusive port range the test suite's own uvicorn servers use, one
# consecutive port each (tests/conftest.py); must not overlap any other port
# in this file. Widen it when a test needs another server - the suite says so
# by name if the range runs out.
WEBSITE_TEST_PORT_MIN=11120
WEBSITE_TEST_PORT_MAX=11199
# Caddy publishes these host ports and forwards /prefix to its private Uvicorn
# backend. Keep the root path slash-prefixed and without a trailing slash.
WEBSITE_PROXY_HTTP_PORT=11210
WEBSITE_PROXY_HTTPS_PORT=11211
WEBSITE_PROXY_BACKEND_PORT=11212
UVICORN_ROOT_PATH="/prefix"
