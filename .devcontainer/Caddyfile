{
	# The API is unnecessary for a static development configuration, and
	# disabling it removes an extra administrative listener.
	admin off
	# The host and container HTTPS ports intentionally differ, so Caddy's
	# automatic redirect would point at the wrong public port. Define the
	# redirect explicitly below instead.
	auto_https disable_redirects
}

http://proxy.localhost {
	redir https://proxy.localhost:{$WEBSITE_PROXY_HTTPS_PORT}{uri} 308
}

https://proxy.localhost {
	# Local CA state persists in the caddy-data volume. The host must trust its
	# root certificate once; see .devcontainer/README.md.
	tls internal

	# Transport-level request-body cap at the trusted proxy, mirroring the
	# app's own guard (DEFAULT_MAX_BODY_BYTES in src/app/config.py - Caddy's
	# "1MB" is the same 10^6 bytes): oversized uploads are refused here before they
	# reach uvicorn. One global cap, deliberately not per-endpoint - new form
	# fields never need a matching proxy change.
	request_body {
		max_size 1MB
	}

	# Keep the canonical public root path slash-terminated.
	@root_path path {$UVICORN_ROOT_PATH}
	redir @root_path {$UVICORN_ROOT_PATH}/ 308

	# handle_path strips the public prefix before forwarding. The proxy backend
	# receives ordinary app paths while UVICORN_ROOT_PATH tells FastAPI to put
	# the public prefix back into every generated URL.
	handle_path {$UVICORN_ROOT_PATH}/* {
		reverse_proxy proxy-backend:{$WEBSITE_PROXY_BACKEND_PORT}
	}

	# This proxy exposes the application only below the configured root path.
	respond "Not found" 404
}
